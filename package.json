{
  "name": "trust-optimize",
  "version": "2.0.0",
  "description": "Advanced media optimization solution for WordPress",
  "scripts": {
    "prepare": "husky",
    "phpcs": "composer phpcs",
    "phpcbf": "composer phpcbf",
    "lint-php": "sh -c 'tools/bin/composer phpcbf -- \"$@\" || true; tools/bin/composer phpcs -- \"$@\"' --",
    "test": "composer test",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.php": [
      "npm run lint-php"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  }
}
