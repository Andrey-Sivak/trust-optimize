#!/usr/bin/env sh
# Usage: tools/bin/test <unit|integration> <8.0|8.4> [wp-version|latest]
set -eu
suite="${1:-}"
php="${2:-}"
case "$suite" in unit|integration) ;; *) echo "Usage: $0 <unit|integration> <8.0|8.4> [wp-version|latest]" >&2; exit 2 ;; esac
case "$php" in 8.0) service=tools-php80 ;; 8.4) service=tools-php84 ;; *) echo "PHP must be 8.0 or 8.4" >&2; exit 2 ;; esac
exec "$(dirname "$0")/compose" run --rm "$service" sh -c '
  if [ ! -x vendor/bin/phpunit ]; then echo "phpunit is not installed: run tools/bin/composer install" >&2; exit 1; fi
  exec vendor/bin/phpunit --testsuite '"$suite"'
'
